# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://mosaic:mosaic@localhost:5432/mosaic

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# ── GitHub OAuth (optional) ───────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth?tab=github

# ── Groq LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=api
DECOMP_MODEL=deepseek-r1-distill-llama-70b
CODING_MODEL=qwen-qwq-32b
MERGE_MODEL=deepseek-r1-distill-llama-70b

# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
DEBUG=false
ROOM_CODE_LENGTH=6
ROOM_TTL_HOURS=48
MAX_TEAMMATES=8
